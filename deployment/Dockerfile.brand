# syntax=docker/dockerfile:1
# ==============================================================================
# RevMarshal Learn — Brand Rebuild Dockerfile
# ==============================================================================
# Rebuilds ONLY the Next.js frontend with RevMarshal Learn brand identity and
# copies standalone assets into the official pinned DeepTutor backend release.
# ==============================================================================

ARG BUILD_REF=unspecified
ARG FORK_SOURCE=https://github.com/RevMarshal/DeepTutor

# Stage 1: Frontend Builder
FROM --platform=$BUILDPLATFORM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS frontend-builder

WORKDIR /app/web

# Copy package files first for layer caching
COPY web/package.json web/package-lock.json* ./

# Install frontend dependencies matching upstream configuration
RUN npm config set fetch-timeout 600000 && \
    npm config set fetch-retries 5 && \
    npm ci --legacy-peer-deps

# Copy frontend source code
COPY web/ ./

# Provide the single source of truth for app version so next.config.js
# can read it during build
COPY deeptutor/__version__.py /app/deeptutor/__version__.py

# Create .env.local with NEXT_PUBLIC_APP_VERSION
RUN printf 'NEXT_PUBLIC_APP_VERSION=\n' > .env.local

# Rasterize brand icons from deterministic SVG vector mark
RUN node ./scripts/generate-brand-icons.mjs

# Build Next.js for production with standalone output
RUN npm run build

# Stage 2: Final Image based on official pinned DeepTutor release
FROM ghcr.io/hkuds/deeptutor:1.6.14@sha256:74fd46c6a55b85f2a1ac294978cc7bac6b1f6d2fe2ed71a44db141688676e08a

ARG BUILD_REF
ARG FORK_SOURCE

LABEL org.opencontainers.image.title="RevMarshal Learn" \
      org.opencontainers.image.description="RevMarshal Learn intelligent learning companion (rebranded frontend on upstream DeepTutor)" \
      org.opencontainers.image.source="${FORK_SOURCE}" \
      org.opencontainers.image.revision="${BUILD_REF}" \
      org.opencontainers.image.base.name="ghcr.io/hkuds/deeptutor:1.6.14@sha256:74fd46c6a55b85f2a1ac294978cc7bac6b1f6d2fe2ed71a44db141688676e08a" \
      com.deeptutor.upstream="https://github.com/HKUDS/DeepTutor" \
      com.revmarshal.brand="RevMarshal Learn"

WORKDIR /app

# Copy built frontend standalone server, static assets, and public directory
# preserving deeptutor:deeptutor user/group ownership
COPY --chown=deeptutor:deeptutor --from=frontend-builder /app/web/.next/standalone/ ./web/
COPY --chown=deeptutor:deeptutor --from=frontend-builder /app/web/.next/static/ ./web/.next/static/
COPY --chown=deeptutor:deeptutor --from=frontend-builder /app/web/public/ ./web/public/
